# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI API key (GPT-4o)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (has full DB access — keep secret)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Admin key used to authenticate POST/DELETE /v1/keys endpoints
ADMIN_KEY=your-admin-key-here

# ── Optional (defaults shown) ──────────────────────────────────────────────────
# Port the server binds to (also read by Docker via PORT env var)
PORT=8000

# Enable PubMed evidence retrieval
PUBMED_ENABLED=true

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=500
